{
  "name": "codexwars",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.23.1",
    "npm": ">=10"
  },
  "scripts": {
    "mobile": "npm run start --workspace @codexwars/mobile",
    "server": "npm run dev --workspace @codexwars/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}

{
  "name": "codexwars",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.23.1",
    "npm": ">=10"
  },
  "overrides": {
    "@types/react": "19.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "zod": "4.1.12"
  },
  "scripts": {
    "mobile": "npm run start --workspace @codexwars/mobile",
    "server": "npm run dev --workspace @codexwars/server",
    "test:openai-live": "npm run test:openai-live --workspace @codexwars/server",
    "test:secrets": "node scripts/check-secrets.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}

{
  "name": "codexwars",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "overrides": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "mobile": "npm run start --workspace @codexwars/mobile",
    "server": "npm run dev --workspace @codexwars/server",
    "seed:quiz": "npm run seed:quiz --workspace @codexwars/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}

# Required by the server for Firestore-backed quiz templates, submissions, and
# results. The Admin SDK uses Application Default Credentials; keep a downloaded
# service-account key outside this repository and point GOOGLE_APPLICATION_CREDENTIALS
# at it only when local ADC is not used.
FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repository/admin-key.json

# Optional: development-only Firestore emulator for the server.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Colyseus server port. Cloud Run supplies PORT automatically.
PORT=4000

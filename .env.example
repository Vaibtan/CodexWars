# Optional. The Colyseus server defaults to 4000.
PORT=4000
# Server-only. Leave unset to use the curated fallback without calling OpenAI.
QUIZ_GENERATION_ENABLED=false
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
QUIZ_PREPARATION_TIMEOUT_MS=20000
QUIZ_GENERATION_RETRY_LIMIT=1
QUIZ_CIRCUIT_FAILURE_THRESHOLD=3
QUIZ_CIRCUIT_COOLDOWN_MS=60000
QUIZ_EVIDENCE_CACHE_TTL_MS=900000
QUIZ_EVIDENCE_CACHE_MAX_ENTRIES=64
QUIZ_MAX_CONCURRENT_GENERATIONS=2
QUIZ_MAX_REGENERATIONS_PER_ROUND=2
QUIZ_DAILY_GENERATION_LIMIT=500
QUIZ_DAILY_SEARCH_LIMIT=2000
TRUST_PROXY=false

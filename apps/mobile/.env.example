# Firebase Web configuration. These values are intentionally client-visible;
# never place a Firebase Admin credential or service-account JSON in this file.
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-web-app-id
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.REGION.firebasedatabase.app

# Optional, development only. Use the laptop LAN IP for a physical phone,
# never 127.0.0.1. Omit this variable to use the real Firebase project.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10
